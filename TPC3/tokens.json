[
    {
        "id": "COMMENT",
        "expreg": "#[^\\n]*"
    },
    {
        "id": "LIMIT",
        "expreg": "LIMIT\\b"
    },
    {
        "id": "VAR",
        "expreg": "\\?[a-zA-Z0-9_]+"
    },
    {
        "id": "LANG",
        "expreg": "@[a-zA-Z]{2}"
    },
    {
        "id": "STRING",
        "expreg": "\"[^\"]*\""
    },
    {
        "id": "NUM",
        "expreg": "\\d+"
    },
    {
        "id": "DELIM",
        "expreg": "[\\{\\}\\.]"
    },
    {
        "id": "ID",
        "expreg": "[a-zA-Z_][a-zA-Z0-9_:]*"
    },
    {
        "id": "SKIP",
        "expreg": "[ \\t]+"
    },
    {
        "id": "NEWLINE",
        "expreg": "\\n"
    },
    {
        "id": "ERRO",
        "expreg": "."
    }
]